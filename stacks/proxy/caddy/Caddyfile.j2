# {{ ansible_managed }}
{# zweite Adresse derselben Seite: https://<LAN-IP>:<Port> (caddy_lan_ports) #}
{% macro lan(app) %}{% if caddy_lan_ports | bool %}, https://{{ ansible_facts.default_ipv4.address }}:{{ stacks_lan_ports[app] }}{% endif %}{% endmacro %}
{
	# eigene CA für alle Seiten (D17); Stammzertifikat unter http://{{ domain }}/ca.crt
	local_certs
}

(geschuetzt) {
	basic_auth {
		{{ admin_user }} {{ stacks_web_password_hash }}
	}
}

# Stammzertifikat per HTTP abholbar, damit Geräte ohne installierte CA es laden können
http://{{ domain }} {
	handle /ca.crt {
		root * /data/caddy/pki/authorities/local
		rewrite * /root.crt
		header Content-Type application/x-x509-ca-cert
		file_server
	}
	handle {
		redir https://{{ stacks_hosts.homepage }}.{{ domain }}{uri}
	}
}

{{ domain }} {
	redir https://{{ stacks_hosts.homepage }}.{{ domain }}{uri}
}

{{ stacks_hosts.homepage }}.{{ domain }} {
	reverse_proxy 127.0.0.1:{{ stacks_ports.homepage }}
}

{{ stacks_hosts.arcane }}.{{ domain }}{{ lan('arcane') }} {
	reverse_proxy 127.0.0.1:{{ stacks_ports.arcane }}
}

{{ stacks_hosts.beszel }}.{{ domain }}{{ lan('beszel') }} {
	reverse_proxy 127.0.0.1:{{ stacks_ports.beszel }}
}

{{ stacks_hosts.dozzle }}.{{ domain }}{{ lan('dozzle') }} {
	import geschuetzt
	reverse_proxy 127.0.0.1:{{ stacks_ports.dozzle }} {
		# Dozzle (forward-proxy) übernimmt den bei Caddy angemeldeten Benutzer
		header_up Remote-User {http.auth.user.id}
	}
}

{{ stacks_hosts.scrutiny }}.{{ domain }}{{ lan('scrutiny') }} {
	import geschuetzt
	reverse_proxy 127.0.0.1:{{ stacks_ports.scrutiny }}
}

{{ stacks_hosts.ntfy }}.{{ domain }}{{ lan('ntfy') }} {
	reverse_proxy 127.0.0.1:{{ stacks_ports.ntfy }}
}
{% if apps.adguard | bool %}

{{ stacks_hosts.adguard }}.{{ domain }}{{ lan('adguard') }} {
	reverse_proxy 127.0.0.1:{{ stacks_ports.adguard_ui }}
}
{% endif %}
{% if apps.uptime_kuma | bool %}

{{ stacks_hosts.uptime_kuma }}.{{ domain }} {
	reverse_proxy 127.0.0.1:{{ stacks_ports.uptime_kuma }}
}
{% endif %}

# --- Medien (M5) ---
{% for app in ['prowlarr', 'sonarr', 'radarr', 'lidarr'] %}
{{ stacks_hosts[app] }}.{{ domain }}{{ lan(app) }} {
	reverse_proxy 127.0.0.1:{{ stacks_ports[app] }}
}

{% endfor %}
# ohne eigene, automatisch setzbare Anmeldung: Passwort in Caddy
{% for app in ['sabnzbd', 'bazarr'] %}
{{ stacks_hosts[app] }}.{{ domain }}{{ lan(app) }} {
	import geschuetzt
	reverse_proxy 127.0.0.1:{{ stacks_ports[app] }}
}

{% endfor %}
{% if apps.emby | bool %}
{{ stacks_hosts.emby }}.{{ domain }} {
	reverse_proxy 127.0.0.1:{{ stacks_ports.emby }}
}

{% endif %}
{% if apps.recommendarr | bool %}
# eigene App ohne Login: Passwort in Caddy
{{ stacks_hosts.recommendarr }}.{{ domain }}{{ lan('recommendarr') }} {
	import geschuetzt
	reverse_proxy 127.0.0.1:{{ stacks_ports.recommendarr }}
}

{% endif %}
{% if apps.ps2gamemanager | bool %}
# hat Schreibzugriff auf die ganze Datenplatte: Passwort in Caddy
{{ stacks_hosts.ps2gamemanager }}.{{ domain }}{{ lan('ps2gamemanager') }} {
	import geschuetzt
	reverse_proxy 127.0.0.1:{{ stacks_ports.ps2gamemanager }}
}

{% endif %}
{{ stacks_hosts.cockpit }}.{{ domain }} {
	reverse_proxy https://127.0.0.1:9090 {
		transport http {
			tls_insecure_skip_verify
		}
	}
}
