# {{ ansible_managed }}
- Verwaltung:
    - Cockpit:
        href: https://{{ stacks_hosts.cockpit }}.{{ domain }}
        description: System, Platten, Updates, Samba-Freigaben
        icon: cockpit.png
    - Arcane:
        href: https://{{ stacks_hosts.arcane }}.{{ domain }}
        description: Docker-Stacks verwalten
        icon: mdi-docker
        server: lokal
        container: arcane
    - Stammzertifikat:
        href: http://{{ domain }}/ca.crt
        description: Einmal pro Gerät installieren, dann gibt es keine Zertifikatswarnungen mehr
        icon: mdi-certificate

- Überwachung:
    - Beszel:
        href: https://{{ stacks_hosts.beszel }}.{{ domain }}
        description: CPU, RAM, Netz, Temperaturen, Container, Alarme
        icon: beszel.png
        server: lokal
        container: beszel
    - Scrutiny:
        href: https://{{ stacks_hosts.scrutiny }}.{{ domain }}
        description: Gesundheit der Festplatten (SMART)
        icon: scrutiny.png
        server: lokal
        container: scrutiny
    - Dozzle:
        href: https://{{ stacks_hosts.dozzle }}.{{ domain }}
        description: Container-Logs
        icon: dozzle.png
        server: lokal
        container: dozzle
    - ntfy:
        href: https://{{ stacks_hosts.ntfy }}.{{ domain }}
        description: Benachrichtigungen
        icon: ntfy.png
        server: lokal
        container: ntfy
{% if apps.uptime_kuma | bool %}
    - Uptime Kuma:
        href: https://{{ stacks_hosts.uptime_kuma }}.{{ domain }}
        description: Erreichbarkeit der Dienste
        icon: uptime-kuma.png
        server: lokal
        container: uptime-kuma
{% endif %}

- Medien:
{% if apps.emby | bool %}
    - Emby:
        href: https://{{ stacks_hosts.emby }}.{{ domain }}
        description: Filme, Serien, Musik
        icon: emby.png
        server: lokal
        container: emby
{% endif %}
{% for app, text in [('sonarr', 'Serien'), ('radarr', 'Filme'), ('lidarr', 'Musik'), ('prowlarr', 'Indexer'), ('sabnzbd', 'Usenet-Downloads'), ('bazarr', 'Untertitel')] %}
    - {{ app | capitalize if app != 'sabnzbd' else 'SABnzbd' }}:
        href: https://{{ stacks_hosts[app] }}.{{ domain }}
        description: {{ text }}
        icon: {{ app }}.png
        server: lokal
        container: {{ app }}
{% endfor %}
{% if apps.recommendarr | bool %}
    - Recommendarr:
        href: https://{{ stacks_hosts.recommendarr }}.{{ domain }}
        description: Empfehlungen (eigene App)
        icon: mdi-star-shooting
        server: lokal
        container: recommendarr
{% endif %}
{% if apps.ps2gamemanager | bool %}
    - PS2GameManager:
        href: https://{{ stacks_hosts.ps2gamemanager }}.{{ domain }}
        description: PS2-Spiele für OPL (eigene App)
        icon: mdi-sony-playstation
        server: lokal
        container: ps2gamemanager
{% endif %}
{% if apps.adguard | bool %}

- Netzwerk:
    - AdGuard Home:
        href: https://{{ stacks_hosts.adguard }}.{{ domain }}
        description: DNS und Werbeblocker fürs Heimnetz
        icon: adguard-home.png
        server: lokal
        container: adguard
{% endif %}
