# {{ ansible_managed }}
PermitRootLogin no
{% if ssh_authorized_keys | length > 0 %}
PasswordAuthentication no
KbdInteractiveAuthentication no
{% else %}
# Kein Schlüssel in ssh_authorized_keys: Passwort-Login bleibt aktiv
{% endif %}
PubkeyAuthentication yes
AllowGroups sudo
MaxAuthTries 4
LoginGraceTime 30
X11Forwarding no
AllowAgentForwarding no
